{
  "name": "urbanoflashcar",
  "version": "0.1.7",
  "description": "UrbanoFlashCar — plataforma própria de corridas urbanas (MVP verificável).",
  "type": "module",
  "private": true,
  "author": {
    "name": "UrbanoFlashCar",
    "email": "dev@urbanoflashcar.app"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "test": "node --experimental-sqlite --test \"test/*.test.js\"",
    "icons": "node scripts/gen-icons.mjs",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "electron-builder",
    "desktop:build:linux": "electron-builder --linux",
    "desktop:build:win": "electron-builder --win",
    "desktop:build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.urbanoflashcar.app",
    "productName": "UrbanoFlashCar",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "empresaexemplo9-gif",
        "repo": "urbanoflashcar",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "public/icons/icon-512.png",
      "maintainer": "UrbanoFlashCar <dev@urbanoflashcar.app>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.travel",
      "icon": "public/icons/icon-512.png"
    }
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
